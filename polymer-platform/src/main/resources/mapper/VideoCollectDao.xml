    </select>

<!--    我的收藏-->
    <select id="selectMyVideoCollectVO" resultType="com.ruoyi.platform.vo.MyVideoCollectVO">
        select tv.id videoId, tv.name, tv.video_cover as videoCover
        from t_video_collect tvc
                left join t_video tv on tvc.video_id = tv.id
        where tvc.user_id = #{userId,jdbcType=INTEGER} and tv.del_status=1 and tv.status=1
        order by tvc.create_time desc
    </select>

