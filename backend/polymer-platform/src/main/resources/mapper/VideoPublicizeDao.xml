<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.platform.mapper.VideoPublicizeDao">
    <resultMap id="BaseResultMap" type="com.ruoyi.platform.domain.VideoPublicize">
        <id column="id" jdbcType="INTEGER" property="id"/>
        <result column="user_id" jdbcType="INTEGER" property="userId"/>
        <result column="video_id" jdbcType="INTEGER" property="videoId"/>
        <result column="unlock" jdbcType="INTEGER" property="unlock"/>
        <result column="create_time" jdbcType="TIMESTAMP" property="createTime"/>
        <result column="update_time" jdbcType="TIMESTAMP" property="updateTime"/>
    </resultMap>
    <sql id="Base_Column_List">
        id, user_id, video_id, `unlock`, create_time, update_time
    </sql>
    <insert id="insertSelective" keyColumn="id" keyProperty="id"
            parameterType="com.ruoyi.platform.domain.VideoPublicize" useGeneratedKeys="true">
        insert into t_video_publicize
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">
                user_id,
            </if>
            <if test="videoId != null">
                video_id,
            </if>
            <if test="unlock != null">
                `unlock`,
            </if>
            <if test="createTime != null">
                create_time,
            </if>
            <if test="updateTime != null">
                update_time,
            </if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">
                #{userId,jdbcType=INTEGER},
            </if>
            <if test="videoId != null">
                #{videoId,jdbcType=INTEGER},
            </if>
            <if test="unlock != null">
                #{unlock},
            </if>
            <if test="createTime != null">
                #{createTime,jdbcType=TIMESTAMP},
            </if>
            <if test="updateTime != null">
                #{updateTime,jdbcType=TIMESTAMP},
            </if>
        </trim>
    </insert>
    <select id="selectVideoPublicizeByUserIdAndVideoId" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from t_video_publicize
        where user_id = #{userId} and video_id = #{videoId} limit 1
    </select>
</mapper>
