<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.platform.mapper.DetectionMapper">
    
    <resultMap type="Detection" id="DetectionResult">
        <result property="id"    column="id"    />
        <result property="type"    column="type"    />
        <result property="status"    column="status"    />
        <result property="value1"    column="value1"    />
        <result property="value2"    column="value2"    />
        <result property="remarks"    column="remarks"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectDetectionVo">
        select id, type, status,value1,value2, remarks, create_time, update_time from t_detection
    </sql>

    <select id="selectDetectionList" parameterType="Detection" resultMap="DetectionResult">
        <include refid="selectDetectionVo"/>
        <where>  
            <if test="type != null "> and type = #{type}</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="remarks != null  and remarks != ''"> and remarks = #{remarks}</if>
        </where>
    </select>
    
    <select id="selectDetectionById" parameterType="Long" resultMap="DetectionResult">
        <include refid="selectDetectionVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertDetection" parameterType="Detection" useGeneratedKeys="true" keyProperty="id">
        insert into t_detection
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="type != null">type,</if>
            <if test="status != null">status,</if>
            <if test="remarks != null">remarks,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="type != null">#{type},</if>
            <if test="status != null">#{status},</if>
            <if test="remarks != null">#{remarks},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateDetection" parameterType="Detection">
        update t_detection
        <trim prefix="SET" suffixOverrides=",">
            <if test="type != null">type = #{type},</if>
            <if test="status != null">status = #{status},</if>
            <if test="value1 != null">value1 = #{value1},</if>
            <if test="value2 != null">value2 = #{value2},</if>
            <if test="remarks != null">remarks = #{remarks},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteDetectionById" parameterType="Long">
        delete from t_detection where id = #{id}
    </delete>

    <delete id="deleteDetectionByIds" parameterType="String">
        delete from t_detection where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <update id="updateValueIsNull">
        update t_detection
        set value1=null,
            value2=null
        where id = #{id}
    </update>
</mapper>