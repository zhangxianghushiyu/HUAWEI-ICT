<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.platform.mapper.GoodsMapper">
    
    <resultMap type="Goods" id="GoodsResult">
        <result property="id"    column="id"    />
        <result property="goodsType"    column="goods_type"    />
        <result property="name"    column="name"    />
        <result property="leafPrice"    column="leaf_price"    />
        <result property="upStatus"    column="up_status"    />
        <result property="url"    column="url"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectGoodsVo">
        select id, goods_type, name, leaf_price, up_status, url, create_time, update_time from t_goods
    </sql>

    <select id="selectGoodsList" parameterType="Goods" resultMap="GoodsResult">
        select tg.*, tgt.type_name as typeName
        from t_goods tg
        left join t_goods_type tgt on tg.goods_type = tgt.id
        <where>
            <if test="goodsType != null "> and tg.goods_type = #{goodsType}</if>
            <if test="name != null  and name != ''"> and tg.name like concat('%', #{name}, '%')</if>
            <if test="leafPrice != null "> and tg.leaf_price = #{leafPrice}</if>
            <if test="upStatus != null "> and tg.up_status = #{upStatus}</if>
            <if test="url != null  and url != ''"> and tg.url = #{url}</if>
        </where>
        order by tg.create_time desc
    </select>

    <select id="selectGoodsById" parameterType="Long" resultMap="GoodsResult">
        <include refid="selectGoodsVo"/>
        where id = #{id}
    </select>

    <insert id="insertGoods" parameterType="Goods" useGeneratedKeys="true" keyProperty="id">
        insert into t_goods
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="goodsType != null">goods_type,</if>
            <if test="name != null">name,</if>
            <if test="leafPrice != null">leaf_price,</if>
            <if test="upStatus != null">up_status,</if>
            <if test="url != null">url,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="goodsType != null">#{goodsType},</if>
            <if test="name != null">#{name},</if>
            <if test="leafPrice != null">#{leafPrice},</if>
            <if test="upStatus != null">#{upStatus},</if>
            <if test="url != null">#{url},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>

    <update id="updateGoods" parameterType="Goods">
        update t_goods
        <trim prefix="SET" suffixOverrides=",">
            <if test="goodsType != null">goods_type = #{goodsType},</if>
            <if test="name != null">name = #{name},</if>
            <if test="leafPrice != null">leaf_price = #{leafPrice},</if>
            <if test="upStatus != null">up_status = #{upStatus},</if>
            <if test="url != null">url = #{url},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteGoodsById" parameterType="Long">
        delete from t_goods where id = #{id}
    </delete>

    <delete id="deleteGoodsByIds" parameterType="String">
        delete from t_goods where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <update id="undercarriage" parameterType="String">
        update t_goods set `up_status` = 0 where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <update id="grounding" parameterType="String">
        update t_goods set `up_status` = 1 where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>
</mapper>