<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.platform.mapper.TaKuConfigMapper">
    
    <resultMap type="TaKuConfig" id="TaKuConfigResult">
        <result property="id"    column="id"    />
        <result property="type"    column="type"    />
        <result property="value"    column="value"    />
        <result property="sign"    column="sign"    />
        <result property="remarks"    column="remarks"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectTaKuConfigVo">
        select id, type, value, sign, remarks, create_time, update_time from t_ta_ku_config
    </sql>

    <select id="selectTaKuConfigList" parameterType="TaKuConfig" resultMap="TaKuConfigResult">
        <include refid="selectTaKuConfigVo"/>
        <where>  
            <if test="type != null "> and type = #{type}</if>
            <if test="value != null  and value != ''"> and value = #{value}</if>
            <if test="sign != null  and sign != ''"> and sign = #{sign}</if>
            <if test="remarks != null  and remarks != ''"> and remarks = #{remarks}</if>
        </where>
    </select>
    
    <select id="selectTaKuConfigById" parameterType="Long" resultMap="TaKuConfigResult">
        <include refid="selectTaKuConfigVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertTaKuConfig" parameterType="TaKuConfig" useGeneratedKeys="true" keyProperty="id">
        insert into t_ta_ku_config
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="type != null">type,</if>
            <if test="value != null">value,</if>
            <if test="sign != null">sign,</if>
            <if test="remarks != null">remarks,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="type != null">#{type},</if>
            <if test="value != null">#{value},</if>
            <if test="sign != null">#{sign},</if>
            <if test="remarks != null">#{remarks},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateTaKuConfig" parameterType="TaKuConfig">
        update t_ta_ku_config
        <trim prefix="SET" suffixOverrides=",">
            <if test="type != null">type = #{type},</if>
            <if test="value != null">value = #{value},</if>
            <if test="sign != null">sign = #{sign},</if>
            <if test="remarks != null">remarks = #{remarks},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteTaKuConfigById" parameterType="Long">
        delete from t_ta_ku_config where id = #{id}
    </delete>

    <delete id="deleteTaKuConfigByIds" parameterType="String">
        delete from t_ta_ku_config where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>