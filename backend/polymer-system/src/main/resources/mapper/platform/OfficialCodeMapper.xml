<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.platform.mapper.OfficialCodeMapper">
    
    <resultMap type="OfficialCode" id="OfficialCodeResult">
        <result property="id"    column="id"    />
        <result property="content"    column="content"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectOfficialCodeVo">
        select id, content, create_time, update_time from t_official_code
    </sql>

    <select id="selectOfficialCodeList" parameterType="OfficialCode" resultMap="OfficialCodeResult">
        <include refid="selectOfficialCodeVo"/>
        <where>  
            <if test="content != null  and content != ''"> and content = #{content}</if>
        </where>
    </select>
    
    <select id="selectOfficialCodeById" parameterType="Long" resultMap="OfficialCodeResult">
        <include refid="selectOfficialCodeVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertOfficialCode" parameterType="OfficialCode" useGeneratedKeys="true" keyProperty="id">
        insert into t_official_code
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="content != null">content,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="content != null">#{content},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateOfficialCode" parameterType="OfficialCode">
        update t_official_code
        <trim prefix="SET" suffixOverrides=",">
            <if test="content != null">content = #{content},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteOfficialCodeById" parameterType="Long">
        delete from t_official_code where id = #{id}
    </delete>

    <delete id="deleteOfficialCodeByIds" parameterType="String">
        delete from t_official_code where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="selectOfficialCodeInfo"   resultMap="OfficialCodeResult">
        <include refid="selectOfficialCodeVo"/>
        limit 1
    </select>
</mapper>