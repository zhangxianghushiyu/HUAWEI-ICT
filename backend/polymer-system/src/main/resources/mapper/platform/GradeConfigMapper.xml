<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.platform.mapper.GradeConfigMapper">
    
    <resultMap type="GradeConfig" id="GradeConfigResult">
        <result property="id"    column="id"    />
        <result property="grade"    column="grade"    />
        <result property="barrier"    column="barrier"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectGradeConfigVo">
        select id, grade, barrier, create_time, update_time from t_grade_config
    </sql>

    <select id="selectGradeConfigList" parameterType="GradeConfig" resultMap="GradeConfigResult">
        <include refid="selectGradeConfigVo"/>
        <where>  
            <if test="grade != null "> and grade = #{grade}</if>
            <if test="barrier != null "> and barrier = #{barrier}</if>
        </where>
    </select>
    
    <select id="selectGradeConfigById" parameterType="Long" resultMap="GradeConfigResult">
        <include refid="selectGradeConfigVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertGradeConfig" parameterType="GradeConfig" useGeneratedKeys="true" keyProperty="id">
        insert into t_grade_config
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="grade != null">grade,</if>
            <if test="barrier != null">barrier,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="grade != null">#{grade},</if>
            <if test="barrier != null">#{barrier},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateGradeConfig" parameterType="GradeConfig">
        update t_grade_config
        <trim prefix="SET" suffixOverrides=",">
            <if test="grade != null">grade = #{grade},</if>
            <if test="barrier != null">barrier = #{barrier},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteGradeConfigById" parameterType="Long">
        delete from t_grade_config where id = #{id}
    </delete>

    <delete id="deleteGradeConfigByIds" parameterType="String">
        delete from t_grade_config where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>



    <select id="selectGradeConfigByGrade"  resultMap="GradeConfigResult">
        <include refid="selectGradeConfigVo"/>
        where grade=#{grade} limit 1
    </select>
</mapper>