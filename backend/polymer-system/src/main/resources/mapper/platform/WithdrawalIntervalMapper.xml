<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.platform.mapper.WithdrawalIntervalMapper">
    
    <resultMap type="WithdrawalInterval" id="WithdrawalIntervalResult">
        <result property="id"    column="id"    />
        <result property="day"    column="day"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectWithdrawalIntervalVo">
        select id, day, create_time, update_time from t_withdrawal_interval
    </sql>

    <select id="selectWithdrawalIntervalList" parameterType="WithdrawalInterval" resultMap="WithdrawalIntervalResult">
        <include refid="selectWithdrawalIntervalVo"/>
        <where>  
            <if test="day != null "> and day = #{day}</if>
        </where>
    </select>
    
    <select id="selectWithdrawalIntervalById" parameterType="Long" resultMap="WithdrawalIntervalResult">
        <include refid="selectWithdrawalIntervalVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertWithdrawalInterval" parameterType="WithdrawalInterval" useGeneratedKeys="true" keyProperty="id">
        insert into t_withdrawal_interval
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="day != null">day,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="day != null">#{day},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateWithdrawalInterval" parameterType="WithdrawalInterval">
        update t_withdrawal_interval
        <trim prefix="SET" suffixOverrides=",">
            <if test="day != null">day = #{day},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteWithdrawalIntervalById" parameterType="Long">
        delete from t_withdrawal_interval where id = #{id}
    </delete>

    <delete id="deleteWithdrawalIntervalByIds" parameterType="String">
        delete from t_withdrawal_interval where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>