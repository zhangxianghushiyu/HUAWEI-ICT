<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.platform.mapper.MusicStoreMapper">
    
    <resultMap type="MusicStore" id="MusicStoreResult">
        <result property="id"    column="id"    />
        <result property="name"    column="name"    />
        <result property="answer"    column="answer"    />
        <result property="wrong"    column="wrong"    />
        <result property="url"    column="url"    />
        <result property="status"    column="status"    />
        <result property="remarks"    column="remarks"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectMusicStoreVo">
        select id, name, answer,wrong, url, status, remarks, create_time, update_time from t_music_store
    </sql>

    <select id="selectMusicStoreList" parameterType="MusicStore" resultMap="MusicStoreResult">
        <include refid="selectMusicStoreVo"/>
        <where>
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="answer != null  and answer != ''"> and answer like concat('%', #{answer}, '%')</if>
            <if test="wrong != null  and wrong != ''"> and wrong like concat('%', #{wrong}, '%')</if>
            <if test="url != null  and url != ''"> and url = #{url}</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="remarks != null  and remarks != ''"> and remarks like concat('%', #{remarks}, '%')</if>
        </where>
        order by create_time desc
    </select>
    
    <select id="selectMusicStoreById" parameterType="Long" resultMap="MusicStoreResult">
        <include refid="selectMusicStoreVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertMusicStore" parameterType="MusicStore" useGeneratedKeys="true" keyProperty="id">
        insert into t_music_store
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="name != null">name,</if>
            <if test="answer != null">answer,</if>
            <if test="wrong != null">wrong,</if>
            <if test="url != null">url,</if>
            <if test="status != null">status,</if>
            <if test="remarks != null">remarks,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="name != null">#{name},</if>
            <if test="answer != null">#{answer},</if>
            <if test="wrong != null">#{wrong},</if>
            <if test="url != null">#{url},</if>
            <if test="status != null">#{status},</if>
            <if test="remarks != null">#{remarks},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateMusicStore" parameterType="MusicStore">
        update t_music_store
        <trim prefix="SET" suffixOverrides=",">
            <if test="name != null">name = #{name},</if>
            <if test="answer != null">answer = #{answer},</if>
            <if test="wrong != null">wrong = #{wrong},</if>
            <if test="url != null">url = #{url},</if>
            <if test="status != null">status = #{status},</if>
            <if test="remarks != null">remarks = #{remarks},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteMusicStoreById" parameterType="Long">
        delete from t_music_store where id = #{id}
    </delete>

    <delete id="deleteMusicStoreByIds" parameterType="String">
        delete from t_music_store where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <insert id="batchInsert" parameterType="java.util.List">
        insert into t_music_store (name,answer,
        wrong,url,create_time) values
        <foreach collection="list" item="t" index="index" separator=",">
            (#{t.name}, #{t.answer},#{t.wrong},
            #{t.url},
            #{createTime})
        </foreach>
    </insert>

</mapper>