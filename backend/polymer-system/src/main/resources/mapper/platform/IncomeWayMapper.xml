<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.platform.mapper.IncomeWayMapper">
    
    <resultMap type="IncomeWay" id="IncomeWayResult">
        <result property="id"    column="id"    />
        <result property="type"    column="type"    />
        <result property="moneyMin"    column="money_min"    />
        <result property="moneyMax"    column="money_max"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectIncomeWayVo">
        select id, type, money_min, money_max, create_time, update_time from t_income_way
    </sql>

    <select id="selectIncomeWayList" parameterType="IncomeWay" resultMap="IncomeWayResult">
        <include refid="selectIncomeWayVo"/>
        <where>  
            <if test="type != null "> and type = #{type}</if>
            <if test="moneyMin != null "> and money_min = #{moneyMin}</if>
            <if test="moneyMax != null "> and money_max = #{moneyMax}</if>
        </where>
    </select>
    
    <select id="selectIncomeWayById" parameterType="Long" resultMap="IncomeWayResult">
        <include refid="selectIncomeWayVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertIncomeWay" parameterType="IncomeWay">
        insert into t_income_way
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="type != null">type,</if>
            <if test="moneyMin != null">money_min,</if>
            <if test="moneyMax != null">money_max,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="type != null">#{type},</if>
            <if test="moneyMin != null">#{moneyMin},</if>
            <if test="moneyMax != null">#{moneyMax},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateIncomeWay" parameterType="IncomeWay">
        update t_income_way
        <trim prefix="SET" suffixOverrides=",">
            <if test="type != null">type = #{type},</if>
            <if test="moneyMin != null">money_min = #{moneyMin},</if>
            <if test="moneyMax != null">money_max = #{moneyMax},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteIncomeWayById" parameterType="Long">
        delete from t_income_way where id = #{id}
    </delete>

    <delete id="deleteIncomeWayByIds" parameterType="String">
        delete from t_income_way where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>