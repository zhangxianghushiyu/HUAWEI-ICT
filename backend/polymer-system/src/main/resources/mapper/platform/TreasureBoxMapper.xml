<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.platform.mapper.TreasureBoxMapper">
    
    <resultMap type="TreasureBox" id="TreasureBoxResult">
        <result property="id"    column="id"    />
        <result property="price"    column="price"    />
        <result property="minute"    column="minute"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectTreasureBoxVo">
        select id, price, minute, create_time, update_time from t_treasure_box
    </sql>

    <select id="selectTreasureBoxList" parameterType="TreasureBox" resultMap="TreasureBoxResult">
        <include refid="selectTreasureBoxVo"/>
        <where>  
            <if test="price != null "> and price = #{price}</if>
            <if test="minute != null "> and minute = #{minute}</if>
        </where>
    </select>
    
    <select id="selectTreasureBoxById" parameterType="Long" resultMap="TreasureBoxResult">
        <include refid="selectTreasureBoxVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertTreasureBox" parameterType="TreasureBox" useGeneratedKeys="true" keyProperty="id">
        insert into t_treasure_box
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="price != null">price,</if>
            <if test="minute != null">minute,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="price != null">#{price},</if>
            <if test="minute != null">#{minute},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateTreasureBox" parameterType="TreasureBox">
        update t_treasure_box
        <trim prefix="SET" suffixOverrides=",">
            <if test="price != null">price = #{price},</if>
            <if test="minute != null">minute = #{minute},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteTreasureBoxById" parameterType="Long">
        delete from t_treasure_box where id = #{id}
    </delete>

    <delete id="deleteTreasureBoxByIds" parameterType="String">
        delete from t_treasure_box where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>