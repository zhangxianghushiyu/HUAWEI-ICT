<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.platform.mapper.TaskNewPeopleSignMapper">
    
    <resultMap type="TaskNewPeopleSign" id="TaskNewPeopleSignResult">
        <result property="id"    column="id"    />
        <result property="sort"    column="sort"    />
        <result property="price"    column="price"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectTaskNewPeopleSignVo">
        select id, sort, price, create_time, update_time from t_task_new_people_sign
    </sql>

    <select id="selectTaskNewPeopleSignList" parameterType="TaskNewPeopleSign" resultMap="TaskNewPeopleSignResult">
        <include refid="selectTaskNewPeopleSignVo"/>
        <where>  
            <if test="sort != null "> and sort = #{sort}</if>
            <if test="price != null "> and price = #{price}</if>
        </where>
    </select>
    
    <select id="selectTaskNewPeopleSignById" parameterType="Long" resultMap="TaskNewPeopleSignResult">
        <include refid="selectTaskNewPeopleSignVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertTaskNewPeopleSign" parameterType="TaskNewPeopleSign" useGeneratedKeys="true" keyProperty="id">
        insert into t_task_new_people_sign
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="sort != null">sort,</if>
            <if test="price != null">price,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="sort != null">#{sort},</if>
            <if test="price != null">#{price},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateTaskNewPeopleSign" parameterType="TaskNewPeopleSign">
        update t_task_new_people_sign
        <trim prefix="SET" suffixOverrides=",">
            <if test="sort != null">sort = #{sort},</if>
            <if test="price != null">price = #{price},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteTaskNewPeopleSignById" parameterType="Long">
        delete from t_task_new_people_sign where id = #{id}
    </delete>

    <delete id="deleteTaskNewPeopleSignByIds" parameterType="String">
        delete from t_task_new_people_sign where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>