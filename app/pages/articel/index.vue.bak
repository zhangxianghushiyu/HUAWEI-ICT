<template>
	<view class="content">
		<BaseHeader>
			<view class="head-title">欢乐吧</view>
		</BaseHeader>

		<!-- 顶部头部（全屏 无内边距 无留白） -->
		<view class="top-banner">
			<image src="/static/liuyueliu/liuyueliulogo.jpeg" mode="aspectFill" class="banner-img"></image>
			<view class="banner-overlay">
				<text class="banner-title">六月六星野营地</text>
				<text class="banner-subtitle">
					<text class="tag">贵安新区</text>
					<text class="tag">田园露营</text>
					<text class="tag">布依风情</text>
				</text>
			</view>
		</view>

		<!-- 下面内容 -->
		<view class="body-content">
			<!-- 贴吧模块 -->
			<view class="section">
				<view class="title-bar">
					<view class="title">
						<view class="title-line"></view>
						<text class="title-text">贴吧</text>
					</view>
					<text class="more-text" @click="goToArticleList">更多 ></text>
				</view>

				<scroll-view class="content-list" scroll-x="true" show-scrollbar="false" enhanced>
					<view @tap="toDetail(item)" v-for="(item,index) in articleList" class="content-list-item" :key="index">
						<view class="content-list-item-img">
							<image :src="item.articleImg || `https://picsum.photos/300/200?random=${index}`" mode="aspectFill" lazy-load></image>
						</view>
						<view class="content-list-item-info">
							<text class="title">{{item.articleTitle}}</text>
						</view>
					</view>
					<view class="scroll-placeholder"></view>
				</scroll-view>
			</view>

			<!-- 投票中心模块 -->
			<view class="section">
				<view class="title-bar">
					<view class="title">
						<view class="title-line" style="background: linear-gradient(180deg, #667eea 0%, #764ba2 100%);"></view>
						<text class="title-text">投票中心</text>
					</view>
					<text class="more-text" @click="goToVoteList">更多 ></text>
				</view>

				<scroll-view class="vote-scroll" scroll-x="true" show-scrollbar="false" enhanced>
					<view v-for="(item, index) in voteList.filter(item => item.status === 1)" :key="item.id" class="vote-card" @click="goToVoteDetail(item.id)">
						<view class="vote-cover">
							<!-- 修复图片字段：支持 coverImage、coverImg、image -->
							<image :src="item.coverImage || item.coverImg || item.image || `https://picsum.photos/400/300?random=${index}`" mode="aspectFill" class="cover-img" lazy-load></image>
							<view class="status-tag">
								{{ getStatusText(item.status) }}
							</view>
						</view>
						<view class="vote-content">
							<text class="vote-title">{{ item.title }}</text>
						</view>
					</view>
					<view class="scroll-placeholder"></view>
				</scroll-view>
			</view>

			<!-- 活动报名模块 -->
			<view class="section">
				<view class="title-bar">
					<view class="title">
						<view class="title-line" style="background: linear-gradient(180deg, #FF6B6B 0%, #FF8E53 100%);"></view>
						<text class="title-text">活动报名</text>
					</view>
					<text class="more-text" @click="goToActivityList">更多 ></text>
				</view>

				<scroll-view 
					class="activity-scroll" 
					scroll-x="true" 
					show-scrollbar="false" 
					enhanced
					v-if="activityList.length > 0"
				>
					<view 
						v-for="(item, index) in activityList" 
						:key="item.id" 
						class="activity-card"
						@click="toActivityDetail(item.id)"
					>
						<view class="activity-cover">
							<image 
								:src="item.coverImage || `https://picsum.photos/500/300?random=${index}`" 
								mode="aspectFill" 
								class="cover-img"
							></image>
							<view class="activity-status-tag" :class="'status-' + item.status">
								{{ getActivityStatusText(item.status) }}
							</view>
							<view v-if="item.hasSignedUp" class="signed-badge-corner">
								<text>已报名</text>
							</view>
						</view>
						<view class="activity-card-content">
							<text class="activity-card-title">{{ item.title }}</text>
							<view class="activity-card-info">
								<view class="info-line">
									<text class="info-icon">📍</text>
									<text class="info-text">{{ item.location || '待定' }}</text>
								</view>
								<view class="info-line">
									<text class="info-icon">⏰</text>
									<text class="info-text">{{ formatActivityTime(item.startTime) }}</text>
								</view>
								<view class="info-line">
									<text class="info-icon">👥</text>
									<text class="info-text">{{ item.signupCount || 0 }}人报名</text>
								</view>
							</view>
						</view>
					</view>
					<view class="scroll-placeholder"></view>
				</scroll-view>
				
				<view v-else class="empty-activity-box">
					<text class="empty-text">暂无活动，敬请期待~</text>
				</view>
			</view>
		</view>
	</view>
</template>

<script>
	export default {
		data() {
			return {
				articleList: [],
				voteList: [],
				activityList: []
			};
		},
		onShow() {
			this.getArticlePage();
			this.getVoteList();
			this.getActivityList();
		},
		methods: {
			toDetail(item) {
				uni.setStorageSync('articleId', item.id);
				uni.navigateTo({
					url: '/pages/articel/articleDetail'
				});
			},
			async getArticlePage() {
				const res = await this.$api.getArticlePage({
					pageNum: 1,
					pageSize: 10
				});
				this.articleList = res.data?.list || [];
			},
			goToArticleList() {
				uni.navigateTo({
					url: "/pages/articel/articellist"
				});
			},
			
			async getVoteList() {
				const res = await this.$api.getVoteList();
				this.voteList = res.data || [];
			},
			goToVoteDetail(activityId) {
				uni.navigateTo({
					url: `/pages/vote/detail?id=${activityId}`
				});
			},
			goToVoteList() {
				uni.navigateTo({
					url: "/pages/vote/list"
				});
			},
			getStatusText(status) {
				const map = { 0: '未开始', 1: '进行中', 2: '已结束' };
				return map[status] || '未知';
			},
			
			async getActivityList() {
				try {
					const res = await this.$api.getActivityList({
						pageNum: 1,
						pageSize: 5
					});
					if (res.code === 200) {
						this.activityList = res.data?.list || [];
					} else {
						console.warn('活动列表加载失败:', res.msg);
						this.activityList = [];
					}
				} catch (error) {
					console.error('获取活动列表失败:', error);
					this.activityList = [];
				}
			},
			goToActivityList() {
				uni.navigateTo({
					url: "/pages/activity/list"
				});
			},
			toActivityDetail(activityId) {
				uni.navigateTo({
					url: `/pages/activity/detail?id=${activityId}`
				});
			},
			getActivityStatusText(status) {
				const map = {
					0: '未开始',
					1: '进行中',
					2: '已结束'
				};
				return map[status] || '未知';
			},
			formatActivityTime(timeStr) {
				if (!timeStr) return '待定';
				const date = new Date(timeStr);
				const month = date.getMonth() + 1;
				const day = date.getDate();
				return `${month}月${day}日`;
			}
		}
	}
</script>

<style lang="scss" scoped>
