<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.platform.mapper.UserGradeMapper">
    
    <resultMap type="UserGrade" id="UserGradeResult">
        <result property="id"    column="id"    />
        <result property="userId"    column="user_id"    />
        <result property="grade"    column="grade"    />
        <result property="barrier"    column="barrier"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectUserGradeVo">
        select id, user_id, grade, barrier, create_time, update_time from t_user_grade
    </sql>

    <select id="selectUserGradeList" parameterType="UserGrade" resultMap="UserGradeResult">
        <include refid="selectUserGradeVo"/>
        <where>  
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="grade != null "> and grade = #{grade}</if>
            <if test="barrier != null "> and barrier = #{barrier}</if>
        </where>
    </select>
    
    <select id="selectUserGradeById" parameterType="Long" resultMap="UserGradeResult">
        <include refid="selectUserGradeVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertUserGrade" parameterType="UserGrade" useGeneratedKeys="true" keyProperty="id">
        insert into t_user_grade
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="grade != null">grade,</if>
            <if test="barrier != null">barrier,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="grade != null">#{grade},</if>
            <if test="barrier != null">#{barrier},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateUserGrade" parameterType="UserGrade">
        update t_user_grade
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="grade != null">grade = #{grade},</if>
            <if test="barrier != null">barrier = #{barrier},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteUserGradeById" parameterType="Long">
        delete from t_user_grade where id = #{id}
    </delete>

    <delete id="deleteUserGradeByIds" parameterType="String">
        delete from t_user_grade where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>


    <select id="selectMaxUserGrade"   resultMap="UserGradeResult">
        <include refid="selectUserGradeVo"/>
        where user_id=#{userId} order by grade desc limit 1
    </select>
</mapper>