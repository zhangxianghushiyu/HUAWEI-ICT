            <if test="networkFirmId != null">#{networkFirmId},</if>
            <if test="scenarioId != null">#{scenarioId},</if>
            <if test="packageName != null">#{packageName},</if>
            <if test="platform != null">#{platform},</if>
            <if test="ilrd != null">#{ilrd},</if>
            <if test="sign != null">#{sign},</if>
            <if test="remarks != null">#{remarks},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateTaKuCallback" parameterType="TaKuCallback">
        update t_ta_ku_callback
        <trim prefix="SET" suffixOverrides=",">
            <if test="scene != null">scene = #{scene},</if>
            <if test="money != null">money = #{money},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="extraData != null">extra_data = #{extraData},</if>
            <if test="transId != null">trans_id = #{transId},</if>
            <if test="reqId != null">req_id = #{reqId},</if>
            <if test="rewardName != null">reward_name = #{rewardName},</if>
            <if test="rewardAmount != null">reward_amount = #{rewardAmount},</if>
            <if test="placementId != null">placement_id = #{placementId},</if>
            <if test="networkFirmId != null">network_firm_id = #{networkFirmId},</if>
            <if test="scenarioId != null">scenario_id = #{scenarioId},</if>
            <if test="packageName != null">package_name = #{packageName},</if>
            <if test="platform != null">platform = #{platform},</if>
            <if test="ilrd != null">ilrd = #{ilrd},</if>
            <if test="sign != null">sign = #{sign},</if>
            <if test="remarks != null">remarks = #{remarks},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteTaKuCallbackById" parameterType="Long">
        delete from t_ta_ku_callback where id = #{id}
    </delete>

    <delete id="deleteTaKuCallbackByIds" parameterType="String">
        delete from t_ta_ku_callback where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
