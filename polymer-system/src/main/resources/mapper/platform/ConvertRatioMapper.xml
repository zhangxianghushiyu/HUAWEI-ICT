<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.platform.mapper.ConvertRatioMapper">
    
    <resultMap type="ConvertRatio" id="ConvertRatioResult">
        <result property="id"    column="id"    />
        <result property="ratio"    column="ratio"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectConvertRatioVo">
        select id, ratio, create_time, update_time from t_convert_ratio
    </sql>

    <select id="selectConvertRatioList" parameterType="ConvertRatio" resultMap="ConvertRatioResult">
        <include refid="selectConvertRatioVo"/>
        <where>  
            <if test="ratio != null "> and ratio = #{ratio}</if>
        </where>
    </select>
    
    <select id="selectConvertRatioById" parameterType="Long" resultMap="ConvertRatioResult">
        <include refid="selectConvertRatioVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertConvertRatio" parameterType="ConvertRatio" useGeneratedKeys="true" keyProperty="id">
        insert into t_convert_ratio
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="ratio != null">ratio,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="ratio != null">#{ratio},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateConvertRatio" parameterType="ConvertRatio">
        update t_convert_ratio
        <trim prefix="SET" suffixOverrides=",">
            <if test="ratio != null">ratio = #{ratio},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteConvertRatioById" parameterType="Long">
        delete from t_convert_ratio where id = #{id}
    </delete>

    <delete id="deleteConvertRatioByIds" parameterType="String">
        delete from t_convert_ratio where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>



    <select id="selectConvertRatioInfo"  resultMap="ConvertRatioResult">
        <include refid="selectConvertRatioVo"/>
    </select>
</mapper>