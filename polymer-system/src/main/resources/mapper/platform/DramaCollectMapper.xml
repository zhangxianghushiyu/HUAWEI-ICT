<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.platform.mapper.DramaCollectMapper">
    
    <resultMap type="DramaCollect" id="DramaCollectResult">
        <result property="id"    column="id"    />
        <result property="userId"    column="user_id"    />
        <result property="dramaId"    column="drama_id"    />
        <result property="dramaDetailsId"    column="drama_details_id"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectDramaCollectVo">
        select id, user_id, drama_id, drama_details_id, create_time, update_time from t_drama_collect
    </sql>

    <select id="selectDramaCollectList" parameterType="DramaCollect" resultMap="DramaCollectResult">
        <include refid="selectDramaCollectVo"/>
        <where>  
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="dramaId != null "> and drama_id = #{dramaId}</if>
            <if test="dramaDetailsId != null "> and drama_details_id = #{dramaDetailsId}</if>
        </where>
    </select>
    
    <select id="selectDramaCollectById" parameterType="Long" resultMap="DramaCollectResult">
        <include refid="selectDramaCollectVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertDramaCollect" parameterType="DramaCollect" useGeneratedKeys="true" keyProperty="id">
        insert into t_drama_collect
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="dramaId != null">drama_id,</if>
            <if test="dramaDetailsId != null">drama_details_id,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="dramaId != null">#{dramaId},</if>
            <if test="dramaDetailsId != null">#{dramaDetailsId},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateDramaCollect" parameterType="DramaCollect">
        update t_drama_collect
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="dramaId != null">drama_id = #{dramaId},</if>
            <if test="dramaDetailsId != null">drama_details_id = #{dramaDetailsId},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteDramaCollectById" parameterType="Long">
        delete from t_drama_collect where id = #{id}
    </delete>

    <delete id="deleteDramaCollectByIds" parameterType="String">
        delete from t_drama_collect where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>


    <select id="selectDramaCollectListVO"  resultType="com.ruoyi.platform.vo.DramaCollectListVO"
            parameterType="com.ruoyi.platform.dto.DramaCollectListDTO">
        select tdc.id,
               tdc.user_id          userId,
               tdc.drama_id         dramaId,
               tdc.drama_details_id dramaDetailsId,
               tdc.create_time      createTime,
               tdc.update_time      updateTime,
               tu.nick_name         nickName,
               tu.avatar,
               td.`title` as        dramaTitle,
               td.title_img         dramaTitleImg
        from t_drama_collect tdc
        inner JOIN t_drama td on td.id = tdc.drama_id
        inner JOIN t_user tu on tu.id = tdc.user_id
        <if test="nickName!=null">and tu.nick_name like concat('%', #{nickName}, '%')</if>
        <if test="dramaTitle!=null">and td.`title` like concat('%', #{dramaTitle}, '%')</if>
        order by tdc.create_time desc
    </select>
</mapper>