<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.platform.mapper.TaskRewardMapper">
    
    <resultMap type="TaskReward" id="TaskRewardResult">
        <result property="id"    column="id"    />
        <result property="type"    column="type"    />
        <result property="status"    column="status"    />
        <result property="followType"    column="follow_type"    />
        <result property="title"    column="title"    />
        <result property="describe"    column="describe"    />
        <result property="sort"    column="sort"    />
        <result property="rewardType"    column="reward_type"    />
        <result property="price"    column="price"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectTaskRewardVo">
        select id, type,status, follow_type, title, `describe`, sort, reward_type, price, create_time, update_time from t_task_reward
    </sql>

    <select id="selectTaskRewardList" parameterType="TaskReward" resultMap="TaskRewardResult">
        <include refid="selectTaskRewardVo"/>
        <where>  
            <if test="type != null "> and type = #{type}</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="followType != null "> and follow_type = #{followType}</if>
            <if test="title != null  and title != ''"> and title = #{title}</if>
            <if test="describe != null  and describe != ''"> and `describe` = #{describe}</if>
            <if test="sort != null "> and sort = #{sort}</if>
            <if test="rewardType != null "> and reward_type = #{rewardType}</if>
            <if test="price != null "> and price = #{price}</if>
        </where>
        order by `sort` asc
    </select>
    
    <select id="selectTaskRewardById" parameterType="Long" resultMap="TaskRewardResult">
        <include refid="selectTaskRewardVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertTaskReward" parameterType="TaskReward" useGeneratedKeys="true" keyProperty="id">
        insert into t_task_reward
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="type != null">`type`,</if>
            <if test="status != null">`status`,</if>
            <if test="followType != null">follow_type,</if>
            <if test="title != null">title,</if>
            <if test="describe != null">`describe`,</if>
            <if test="sort != null">sort,</if>
            <if test="rewardType != null">reward_type,</if>
            <if test="price != null">price,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="type != null">#{type},</if>
            <if test="status != null">#{status},</if>
            <if test="followType != null">#{followType},</if>
            <if test="title != null">#{title},</if>
            <if test="describe != null">#{describe},</if>
            <if test="sort != null">#{sort},</if>
            <if test="rewardType != null">#{rewardType},</if>
            <if test="price != null">#{price},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateTaskReward" parameterType="TaskReward">
        update t_task_reward
        <trim prefix="SET" suffixOverrides=",">
            <if test="type != null">type = #{type},</if>
            <if test="status != null">status = #{status},</if>
            <if test="followType != null">follow_type = #{followType},</if>
            <if test="title != null">title = #{title},</if>
            <if test="describe != null">`describe` = #{describe},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="rewardType != null">reward_type = #{rewardType},</if>
            <if test="price != null">price = #{price},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteTaskRewardById" parameterType="Long">
        delete from t_task_reward where id = #{id}
    </delete>

    <delete id="deleteTaskRewardByIds" parameterType="String">
        delete from t_task_reward where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>