        </where>
    </select>
    
    <select id="selectTaskDailyFoodPointLookDramaById" parameterType="Long" resultMap="TaskDailyFoodPointLookDramaResult">
        <include refid="selectTaskDailyFoodPointLookDramaVo"/>
