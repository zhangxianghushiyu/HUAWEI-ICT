    </update>

    <delete id="deleteTaskDailyFoodPointLookDramaById" parameterType="Long">
        delete from t_task_daily_food_point_look_drama where id = #{id}
    </delete>

    <delete id="deleteTaskDailyFoodPointLookDramaByIds" parameterType="String">
        delete from t_task_daily_food_point_look_drama where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
