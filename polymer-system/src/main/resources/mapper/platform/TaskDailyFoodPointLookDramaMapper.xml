    </select>
        
    <insert id="insertTaskDailyFoodPointLookDrama" parameterType="TaskDailyFoodPointLookDrama" useGeneratedKeys="true" keyProperty="id">
        insert into t_task_daily_food_point_look_drama
        <trim prefix="(" suffix=")" suffixOverrides=",">
