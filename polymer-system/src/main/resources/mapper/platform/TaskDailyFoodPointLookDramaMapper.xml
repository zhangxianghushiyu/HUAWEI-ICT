    </sql>

    <select id="selectTaskDailyFoodPointLookDramaList" parameterType="TaskDailyFoodPointLookDrama" resultMap="TaskDailyFoodPointLookDramaResult">
        <include refid="selectTaskDailyFoodPointLookDramaVo"/>
